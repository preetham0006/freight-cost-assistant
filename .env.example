# Copy this file to .env and add your own Google AI Studio API key.
# Keep .env private; never commit your real key.
GEMINI_API_KEY=replace_with_your_own_api_key
# Model name is configurable; use the exact model ID enabled for your API account.
GEMINI_MODEL=gemini-3.6-flash
ENABLE_GEMINI=false

# Optional published model prices, in USD per 1,000,000 tokens.
# Leave blank until you confirm the current price for your selected model.
GEMINI_INPUT_USD_PER_MILLION_TOKENS=
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=

# Sentence Transformers embedding model; first use may download model files.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
